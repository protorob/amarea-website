# ---------------------------------------------------------------------------
# ENVIRONMENT VARIABLES — EXAMPLE / TEMPLATE
#
# 1. Copy this file to .env:
#       cp .env.example .env
#
# 2. Fill in the real values below.
#
# .env is gitignored — it's loaded by site/config/env.php, both locally
# and on the deploy target (copy this same file there and fill it in with
# that environment's real values — .env itself is never uploaded by
# deploy.sh, see its --exclude list).
# ---------------------------------------------------------------------------

# SMTP transport for the lead-capture form (site/snippets/lead-form.php,
# POST /lead in site/config/config.php). Without these set, submissions
# fail gracefully with a JSON error instead of crashing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@amarea.co

# Set to "true" to enable Kirby's debug mode (verbose error output) —
# leave unset/false in production.
KIRBY_DEBUG=false
