{
  "name": "protorob/amarea-website",
  "description": "Amarea marketing website — Kirby CMS + Tailwind, with an embedded booking widget served from the ballaraw-booking-engine Coolify service",
  "type": "project",
  "keywords": [
    "kirby",
    "cms",
    "plainkit"
  ],
  "require": {
    "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
    "getkirby/cms": "^5.2"
  },
  "config": {
    "allow-plugins": {
      "getkirby/composer-installer": true
    },
    "optimize-autoloader": true
  },
  "scripts": {
    "start": [
      "Composer\\Config::disableProcessTimeout",
      "@php -S localhost:8000 kirby/router.php"
    ]
  }
}